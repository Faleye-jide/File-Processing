# Copy this file to .env, then edit the connection string to match pgAdmin.
# Never commit .env or credentials. .env is ignored by Git.
# Comment out DATABASE_URL to use the local SQLite default.
# URL-encode special characters in the PostgreSQL password.
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5433/file_processing
